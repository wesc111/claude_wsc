<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blackjack.Gui.ViewModels"
        xmlns:views="using:Blackjack.Gui.Views"
        x:Class="Blackjack.Gui.Views.MainWindow"
        x:DataType="vm:TableViewModel"
        Title="Blackjack"
        Width="1320" Height="900" MinWidth="1100" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#0b5d2a">

    <Window.Styles>
        <!-- A card: the PNG on a white card with a margin of 3 % of width and height (4.5 and 6.5), because
             the symbols of the PNG set reach almost to its edge. -->
        <Style Selector="Border.card">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="218" />
            <Setter Property="Padding" Value="4.5,6.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- While a card flies from the shoe (MainWindow.DealAsync), its place in the hand is reserved but empty. -->
        <Style Selector="Border.card.dealing">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.hand">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.hand.active">
            <Setter Property="BorderBrush" Value="Gold" />
            <Setter Property="Background" Value="#22ffffff" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Buttons and the Sound switch take no keyboard focus, so Space and Enter reach the keyboard shortcuts
             (spec E10) instead of clicking the button clicked last. -->
        <Style Selector="Button, CheckBox">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- The basic strategy action in the hint mode Show (spec E11). -->
        <Style Selector="Button.recommended">
            <Setter Property="BorderBrush" Value="#ffd24a" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.insurance">
            <Setter Property="Background" Value="#102a1a" />
            <Setter Property="BorderBrush" Value="#d4af37" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#cfe8ff" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.hint.mistake">
            <Setter Property="Foreground" Value="#ffb36b" />
        </Style>
        <!-- Chips in the tray and stacks in the bet area: the chip graphic is the whole button. -->
        <Style Selector="Button.chip, Button.stack">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.stack:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.stack:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.stack:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>
        <Style Selector="Button.chip:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Button.chip:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.stack:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <!-- Deal starts the next round: gold, larger and framed. -->
        <Style Selector="Button.deal">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#ffe08a" />
            <Setter Property="Background" Value="#c9a227" />
            <Setter Property="Foreground" Value="#1b1b1b" />
        </Style>
        <Style Selector="Button.deal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#dcb73a" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Foreground" Value="#1b1b1b" />
        </Style>
        <Style Selector="Button.deal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#b08d1f" />
            <Setter Property="Foreground" Value="#1b1b1b" />
        </Style>
        <Style Selector="Button.deal:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#c9a227" />
            <Setter Property="BorderBrush" Value="#ffe08a" />
            <Setter Property="Foreground" Value="#1b1b1b" />
        </Style>
        <Style Selector="Button.deal:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.betarea">
            <Setter Property="CornerRadius" Value="95" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#99ffe08a" />
            <Setter Property="Background" Value="#18ffffff" />
            <Setter Property="Padding" Value="20,50" />
            <Setter Property="Width" Value="190" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- A casino chip drawn at 56 × 56 and scaled to its container: coloured disc, white edge spots,
             white inner field with the value. -->
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ChipViewModel">
            <Viewbox>
                <Panel Width="56" Height="56">
                    <Ellipse Fill="{Binding Color, Converter={StaticResource ColorBrush}}" Stroke="#66000000" StrokeThickness="1" />
                    <!-- 8 spots and 8 gaps on the stroke circle (radius 22.5): 141.4 / 16 / 7 = 1.263 stroke widths each. -->
                    <Ellipse Margin="2" Stroke="#f4f1e8" StrokeThickness="7" StrokeDashArray="1.263,1.263" />
                    <Ellipse Margin="11" Fill="#f4f1e8" Stroke="{Binding Color, Converter={StaticResource ColorBrush}}"
                             StrokeThickness="1.5" StrokeDashArray="2,1.5" />
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color, Converter={StaticResource ColorBrush}}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Viewbox>
        </DataTemplate>

        <!-- A card in a hand or in flight. The negative margin and the rounded clip crop the thin outline of the PNG,
             including its rounded corners; the outer Border draws the card edge. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardViewModel">
            <Border Classes="card" Classes.dealing="{Binding IsDealing}">
                <Border ClipToBounds="True" CornerRadius="7">
                    <Image Margin="-1" Stretch="Fill" Source="{Binding ImageName, Converter={StaticResource CardImage}}" />
                </Border>
            </Border>
        </DataTemplate>

        <!-- A hand: title with total, overlapping cards, bet and result. -->
        <DataTemplate x:Key="HandTemplate" x:DataType="vm:HandViewModel">
            <Border Classes="hand" Classes.active="{Binding IsActive}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="title" Text="{Binding Title}" />
                        <TextBlock Classes="title" Text="{Binding TotalText}" Foreground="#ffe08a" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" MinHeight="218">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Negative spacing overlaps the cards; each card keeps its full size. -->
                                <StackPanel Orientation="Horizontal" Spacing="-87" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- Hidden for the dealer, who has no bet. -->
                    <TextBlock Text="{Binding BetText}" IsVisible="{Binding BetText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding InsuranceText}" IsVisible="{Binding InsuranceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" Foreground="#ffe08a" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- The table, with the flight layer for dealt cards on top. -->
    <Panel>
        <!-- Two columns: betting at the left (bet area, chips, Clear, Deal), the table in the middle (hands, play buttons).
             The chip row and the play buttons share one row, so all buttons are on one line. -->
        <Grid Margin="20" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto,Auto">
            <!-- Header from the left: bankroll, shoe level, decks, Leave table, Settings and the Sound switch; the shoe itself is at the top right. -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding BankrollText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" MinWidth="230" />
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,30,0"
                            ToolTip.Tip="Cards left in the shoe; the white mark shows where it is reshuffled.">
                    <TextBlock Text="{Binding ShoeText}" FontSize="16" VerticalAlignment="Center" MinWidth="120" />
                    <!-- Bar width must match TableViewModel.ShoeBarWidth. -->
                    <Canvas Width="200" Height="14" VerticalAlignment="Center">
                        <ProgressBar Width="200" MinWidth="200" Height="14" MinHeight="14" Minimum="0"
                                     Maximum="{Binding ShoeTotal}" Value="{Binding ShoeRemaining}"
                                     Foreground="#ffe08a" Background="#33ffffff" />
                        <Rectangle Canvas.Left="{Binding ReshuffleMarkerLeft}" Width="2" Height="14" Fill="White" />
                    </Canvas>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Decks:" FontSize="16" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding DeckOptions}" SelectedItem="{Binding Decks}"
                              IsEnabled="{Binding CanChangeDecks}" MinWidth="70" VerticalAlignment="Center" />
                    <Button Content="Leave table" Command="{Binding LeaveTableCommand}" Margin="20,0,0,0" />
                    <Button Content="Settings…" Click="OnSettingsClick" IsEnabled="{Binding IsBetweenRounds}"
                            ToolTip.Tip="Table rules, bankroll and sound (⌘,)" />
                    <CheckBox Content="Sound" IsChecked="{Binding IsSoundOn}" Foreground="White" VerticalAlignment="Center"
                              Margin="20,0,0,0" ToolTip.Tip="Sounds on or off (M)" />
                </StackPanel>
            </StackPanel>

            <!-- Left column, bet area: one row per chip value; clicking a stack takes one chip back. -->
            <Border Grid.Row="1" Classes="betarea" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="22">
                    <!-- Fixed height for four stacks (83 px each), so the area does not jump. -->
                    <Panel Height="362">
                        <TextBlock Text="Click the chips below to bet" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !BetStacks.Count}" />
                        <ItemsControl ItemsSource="{Binding BetStacks}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChipStackViewModel">
                                    <Button Classes="stack" ToolTip.Tip="{Binding Chip.StackTip}"
                                            Command="{Binding $parent[Window].((vm:TableViewModel)DataContext).RemoveChipCommand}"
                                            CommandParameter="{Binding Chip.Value}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ItemsControl ItemsSource="{Binding Layers}" Width="48" Height="83">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Panel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChipLayer">
                                                        <ContentControl Content="{Binding Chip}" ContentTemplate="{StaticResource ChipTemplate}"
                                                                        Width="48" Height="48" VerticalAlignment="Bottom"
                                                                        Margin="{Binding Lift, Converter={StaticResource LiftMargin}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CountText}" VerticalAlignment="Bottom" MinWidth="34" Margin="0,0,0,14" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                    <TextBlock Text="{Binding BetText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Middle: dealer at the top, the table print, player hands at the bottom, then the result of the last round. -->
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="20,0,0,0">
                <!-- The print on the felt (spec E7), behind the cards, in the gap between the dealer's hand and the player
                     hands; its ends rise beside the dealer's cards. -->
                <views:TablePrint Grid.Row="1" Width="740" Height="120" HorizontalAlignment="Center" VerticalAlignment="Top"
                                  Margin="0,-50,0,0"
                                  IsHitTestVisible="False" PayoutText="{Binding PayoutPrint}" RuleText="{Binding DealerRulePrint}"
                                  BannerText="{Binding InsurancePrint}" />
                <ContentControl Content="{Binding Dealer}" ContentTemplate="{StaticResource HandTemplate}"
                                HorizontalAlignment="Center" />
                <ItemsControl Grid.Row="1" ItemsSource="{Binding PlayerHands}" ItemTemplate="{StaticResource HandTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- The insurance box (spec E12): over the table print, between the dealer's and the player's cards, so both
                     stay visible; everything else is disabled until it is answered. No keys. -->
                <Border Grid.Row="1" Classes="insurance" IsVisible="{Binding IsInsuranceOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-20,0,0" ZIndex="1">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="24">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Dealer shows an Ace." FontSize="14" Opacity="0.85" />
                            <TextBlock Text="{Binding InsuranceQuestion}" FontSize="19" FontWeight="SemiBold" Foreground="#ffe08a" />
                            <TextBlock Text="{Binding InsuranceNote}" FontSize="13" Opacity="0.75" />
                            <TextBlock Classes="hint" Text="{Binding Hint}"
                                       IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Button Content="{Binding TakeInsuranceText}" Command="{Binding TakeInsuranceCommand}" MinWidth="130" />
                            <Button Content="{Binding DeclineInsuranceText}" Command="{Binding DeclineInsuranceCommand}" MinWidth="130"
                                    Classes.recommended="{Binding IsNoInsuranceRecommended}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0" Spacing="4">
                    <TextBlock Text="{Binding LastResult}" FontSize="22" FontWeight="Bold" Foreground="#ffe08a"
                               HorizontalAlignment="Center" />
                    <!-- Strategy hint or feedback (spec E11). -->
                    <TextBlock Classes="hint" Classes.mistake="{Binding IsHintMistake}" Text="{Binding Hint}"
                               IsVisible="{Binding IsHintOnTable}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Bet buttons at the left: chip tray (a click puts the chip into the bet area) and Clear. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding ChipTray}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipViewModel">
                            <Button Classes="chip" Content="{Binding}" ContentTemplate="{StaticResource ChipTemplate}" ToolTip.Tip="{Binding TrayTip}"
                                    Command="{Binding $parent[Window].((vm:TableViewModel)DataContext).AddChipCommand}"
                                    CommandParameter="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear" Command="{Binding ClearBetCommand}" ToolTip.Tip="Clear (C)" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <!-- Play buttons in the middle, below the hands; Deal at the right, set apart and highlighted. -->
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="20,12,0,0">
                <Button Content="Hit" Command="{Binding HitCommand}" ToolTip.Tip="Hit (H)" Classes.recommended="{Binding IsHitRecommended}" />
                <Button Content="Stand" Command="{Binding StandCommand}" ToolTip.Tip="Stand (S)" Classes.recommended="{Binding IsStandRecommended}" />
                <Button Content="Double" Command="{Binding DoubleCommand}" ToolTip.Tip="Double (D)" Classes.recommended="{Binding IsDoubleRecommended}" />
                <Button Content="Split" Command="{Binding SplitCommand}" ToolTip.Tip="Split (P)" Classes.recommended="{Binding IsSplitRecommended}" />
                <Button Content="New game" Command="{Binding NewGameCommand}" IsVisible="{Binding IsSessionOver}" ToolTip.Tip="New game (N)" />
                <Button Classes="deal" Content="Deal" Command="{Binding DealCommand}" Margin="30,0,0,0" ToolTip.Tip="Deal (Enter or Space)" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="20,12,0,0" />
        </Grid>
        <!-- The shoe in the top right corner: the next card lies at 45° under a metal plate (a triangle with a finger
             notch), so dealt cards are pulled out from under the plate. Card below the flight layer, plate above it.
             MainWindow.DealAsync starts each card at ShoeMouth (the centre of this card) with its scale and angle. -->
        <Canvas Width="230" Height="230" HorizontalAlignment="Right" VerticalAlignment="Top" ClipToBounds="True"
                IsHitTestVisible="False">
            <Border Classes="card" Canvas.Left="138.2" Canvas.Top="-92.2" RenderTransformOrigin="50%,50%"
                    RenderTransform="rotate(-45deg)">
                <Border ClipToBounds="True" CornerRadius="7">
                    <Image Margin="-1" Stretch="Fill" Source="avares://BlackjackGui/Assets/Cards/card_back.png" />
                </Border>
            </Border>
            <Border x:Name="ShoeMouth" Canvas.Left="213.2" Canvas.Top="16.8" Width="0" Height="0" />
        </Canvas>
        <Canvas x:Name="FlightLayer" IsHitTestVisible="False" />
        <Canvas Width="230" Height="230" HorizontalAlignment="Right" VerticalAlignment="Top" ClipToBounds="True"
                ToolTip.Tip="The shoe">
            <!-- Shadow of the plate edge on the card. -->
            <Path Data="M 130,0 L 230,0 L 230,100 L 199.1,69.1 A 27,27 0 0 0 160.9,30.9 Z" Fill="#55000000">
                <Path.RenderTransform>
                    <TranslateTransform X="-3" Y="3" />
                </Path.RenderTransform>
            </Path>
            <Path Data="M 130,0 L 230,0 L 230,100 L 199.1,69.1 A 27,27 0 0 0 160.9,30.9 Z" Stroke="#7d8186" StrokeThickness="1.5">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="35%,65%">
                        <GradientStop Offset="0" Color="#7c8085" />
                        <GradientStop Offset="0.45" Color="#c4c8cc" />
                        <GradientStop Offset="0.85" Color="#eef0f2" />
                        <GradientStop Offset="1" Color="#d6d9dc" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </Panel>
</Window>
