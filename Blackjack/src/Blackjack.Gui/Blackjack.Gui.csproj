<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Blackjack.Gui</RootNamespace>
    <AssemblyName>BlackjackGui</AssemblyName>
    <!-- Shown in the app bundle (Info.plist) and the DMG name; see scripts/make-macos-app.sh. -->
    <Version>1.8.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 52 cards and the card back from cards-png: court cards in the alternative designs (*2.png), no jokers. -->
    <AvaloniaResource Include="..\..\cards-png\*_of_*.png" Exclude="..\..\cards-png\*2.png;..\..\cards-png\jack_of_*.png;..\..\cards-png\queen_of_*.png;..\..\cards-png\king_of_*.png" Link="Assets\Cards\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\cards-png\jack_of_*2.png;..\..\cards-png\queen_of_*2.png;..\..\cards-png\king_of_*2.png" Link="Assets\Cards\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\cards-png\card_back.png" Link="Assets\Cards\card_back.png" />
    <!-- The selected sounds of Kenney "Casino Audio" (spec E8, docs/SOUNDS.md). -->
    <AvaloniaResource Include="Assets\Sounds\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blackjack.Gui.Tests" />
    <Using Include="Blackjack.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blackjack.Core\Blackjack.Core.csproj" />
    <ProjectReference Include="..\Blackjack.Reports\Blackjack.Reports.csproj" />
  </ItemGroup>

</Project>
